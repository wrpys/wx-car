.tab-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  height: 100rpx; padding-bottom: env(safe-area-inset-bottom);
  display: flex; background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.04); z-index: 999;
}
.tab-item {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.tab-ic {
  width: 48rpx; height: 48rpx; margin-bottom: 6rpx;
  background-repeat: no-repeat; background-position: center; background-size: contain;
}
.tab-text { font-size: 22rpx; color: #9AA0A6; line-height: 1; }
.tab-item.active .tab-text { color: #FFB800; font-weight: 600; }

.ic-home { background-image: url(data:image/png;base64,); }
