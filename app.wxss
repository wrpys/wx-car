/* 服务页彩色图标底圈 */
.svc-ic {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.svc-ic .ic {
  width: 44rpx;
  height: 44rpx;
}

/* ===================== 车源卡片（首页 / 搜索结果 / 批发车通用） ===================== */
.car-card {
  display: flex;
  background: #fff;
  border-radius: var(--r-md);
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.car-card:active {
  background: #fafafa;
}
.cover {
  position: relative;
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.badge-urgent {
  position: absolute;
  top: 0;
  left: 0;
  background: var(--orange);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
}
.badge-new {
  position: absolute;
  top: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--r-sm) 0 0 var(--r-sm);
}
.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 10rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.price-row {
  margin-top: auto;
  display: flex;
  align-items: baseline;
}
.price-old {
  font-size: 20rpx;
  color: var(--text-3);
  text-decoration: line-through;
  margin-left: 12rpx;
}
.list-end {
  text-align: center;
  color: var(--text-3);
  font-size: 22rpx;
  padding: 24rpx 0 8rpx;
}
