page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 20rpx;
}

.text-primary {
  color: #FFD100;
}

.text-danger {
  color: #e74c3c;
}

.text-muted {
  color: #999;
}

.bg-primary {
  background-color: #FFD100;
}

.bg-white {
  background-color: #fff;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.btn-primary {
  background-color: #FFD100;
  color: #000;
  border: none;
  border-radius: 12rpx;
}

.btn-dark {
  background-color: #333;
  color: #fff;
  border: none;
  border-radius: 12rpx;
}