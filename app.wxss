/* ============================================================
   二手车买卖小程序 · 全局样式 v2
   设计基调：明黄主色 + 白底卡片 + 红价签 + 圆角轻量化
   ============================================================ */

page {
  /* ---- 色彩 ---- */
  --primary: #FFB800;
  --primary-dark: #F0A800;
  --primary-light: #FFF6DD;
  --price: #E53935;
  --text-1: #1A1A1A;
  --text-2: #666666;
  --text-3: #9AA0A6;
  --bg: #F4F5F7;
  --card: #FFFFFF;
  --border: #EEF0F2;
  --green: #2BA471;
  --green-bg: #E8F6EF;
  --orange: #FF7A29;
  --orange-bg: #FFF1E6;
  --blue: #3D7FFF;
  --blue-bg: #EAF2FF;

  /* ---- 圆角 / 阴影 ---- */
  --r-sm: 8rpx;
  --r-md: 16rpx;
  --r-lg: 24rpx;
  --r-pill: 999rpx;
  --shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  --shadow-float: 0 8rpx 24rpx rgba(255, 184, 0, 0.35);

  background-color: var(--bg);
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: var(--text-1);
  -webkit-font-smoothing: antialiased;
}

view, text, input, scroll-view, swiper, swiper-item, image {
  box-sizing: border-box;
}

/* ===================== 通用容器 / 卡片 ===================== */
.page {
  min-height: 100vh;
  background-color: var(--bg);
}
.container {
  padding: 24rpx;
}
.card {
  background: var(--card);
  border-radius: var(--r-md);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  margin: 32rpx 0 20rpx;
  padding-left: 4rpx;
}
.row {
  display: flex;
  align-items: center;
}
.between {
  justify-content: space-between;
}

/* ===================== 价格 ===================== */
.price {
  color: var(--price);
  font-weight: 700;
}
.price-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--price);
}
.price-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--price);
  margin-left: 2rpx;
}
.price-old {
  font-size: 22rpx;
  color: var(--text-3);
  text-decoration: line-through;
  margin-left: 10rpx;
}

/* ===================== 标签 ===================== */
.tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  font-size: 20rpx;
  color: var(--text-2);
  background: #F2F3F5;
  border-radius: var(--r-sm);
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}
.tag-green {
  color: var(--green);
  background: var(--green-bg);
}
.tag-orange {
  color: var(--orange);
  background: var(--orange-bg);
}
.tag-primary {
  color: var(--primary-dark);
  background: var(--primary-light);
}
.tag-fuel {
  color: var(--blue);
  background: var(--blue-bg);
}

/* ===================== 按钮 ===================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--r-pill);
  font-size: 30rpx;
  font-weight: 600;
}
.btn-primary {
  background: var(--primary);
  color: #1A1A1A;
  box-shadow: var(--shadow-float);
}
.btn-dark {
  background: #1A1A1A;
  color: #fff;
}
.btn-ghost {
  background: #fff;
  color: var(--text-1);
  border: 1rpx solid var(--border);
}

/* ===================== 图标库（data-URI SVG，彻底弃用 emoji） ===================== */
.ic {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  vertical-align: middle;
}
