.page {
  padding-bottom: 160rpx;
}

.banner {
  margin: 24rpx;
  padding: 40rpx 36rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, #FFC93C 0%, #FFB800 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 0, 0.3);
}
.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.banner-sub {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.7);
  margin-top: 10rpx;
}

.list {
  padding: 0 24rpx;
}
.ws-card {
  display: flex;
  background: #fff;
  border-radius: var(--r-md);
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.ws-card:active {
  background: #fafafa;
}
.cover {
  position: relative;
  width: 240rpx;
  height: 180rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: var(--r-sm);
  overflow: hidden;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.stock-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 var(--r-sm) 0 0;
}
.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 10rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.price-row {
  margin-top: auto;
  display: flex;
  align-items: baseline;
}
.price-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-right: 8rpx;
}
.min-batch {
  font-size: 20rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  margin-left: 12rpx;
}
