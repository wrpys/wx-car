<view class="page">
  <!-- 顶部 banner -->
  <view class="banner">
    <view class="banner-title">批发车源 · 整车直供</view>
    <view class="banner-sub">一手车源 · 批量更优惠 · 支持按揭</view>
  </view>

  <view class="list">
    <view class="ws-card" wx:for="{{list}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}">
      <view class="cover">
        <image class="cover-img" src="{{item.cover}}" mode="aspectFill" lazy-load="true"></image>
        <view class="stock-badge">库存 {{item.stock}} 台</view>
      </view>
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="meta">{{item.year}}年 · {{item.mileage}}万公里 · {{item.city}}</view>
        <view class="tags">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
        <view class="price-row">
          <view class="price-label">批发价</view>
          <text class="price-num">{{item.price}}</text>
          <text class="price-unit">万</text>
          <text class="min-batch">起批 {{item.minBatch}} 台</text>
        </view>
      </view>
    </view>
  </view>

  <view class="list-end">更多车源，敬请期待 ~</view>
</view>
