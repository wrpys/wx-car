.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.image-swiper {
  width: 100%;
  height: 500rpx;
}

.car-image {
  width: 100%;
  height: 100%;
}

.image-actions {
  position: relative;
  margin-top: -80rpx;
  padding: 0 24rpx;
}

.download-btn {
  position: absolute;
  top: -60rpx;
  right: 24rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.image-counter {
  position: absolute;
  top: -60rpx;
  right: 200rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.price-bar {
  background-color: #FFD100;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-value {
  color: #e74c3c;
  font-size: 36rpx;
  font-weight: 600;
  margin: 0 8rpx;
}

.car-id {
  font-size: 24rpx;
  color: #333;
}

.card {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 22rpx;
  background-color: #f0f0f0;
  color: #666;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.tag-info {
  background-color: #e3f2fd;
  color: #1976d2;
}

.tag-warning {
  background-color: #fff3e0;
  color: #ff6b35;
}

.publish-time {
  font-size: 24rpx;
  color: #999;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.highlight-info {
  display: flex;
  border: 2rpx solid #FFD100;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 22rpx;
  color: #999;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 50%;
  display: flex;
  padding: 16rpx 0;
}

.grid-item .label {
  color: #999;
  width: 140rpx;
  font-size: 26rpx;
}

.grid-item .value {
  flex: 1;
  font-size: 26rpx;
}

.more-btn {
  text-align: center;
  color: #666;
  font-size: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 24rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.call-btn {
  background-color: #333;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}