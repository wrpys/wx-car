.page {
  background: var(--bg);
}

/* 图片画廊 */
.gallery {
  position: relative;
  width: 100%;
  height: 520rpx;
}
.g-swiper, .g-img {
  width: 100%;
  height: 100%;
}
.g-counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
}
.g-download {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--r-pill);
}

/* 价格卡 */
.price-card {
  margin-top: -28rpx;
  position: relative;
  border-radius: var(--r-lg) var(--r-lg) 0 0;
}
.price-main {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}
.car-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.4;
  margin-bottom: 14rpx;
}
.sub-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}
.sub-meta .dot {
  margin: 0 10rpx;
}

/* 关键参数 */
.key-card {
  display: flex;
  background: var(--primary-light);
}
.key-item {
  flex: 1;
  text-align: center;
  position: relative;
}
.key-item::after {
  content: '';
  position: absolute;
  right: 0;
  top: 12rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: rgba(255, 184, 0, 0.3);
}
.key-item:last-child::after { display: none; }
.key-val {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
}
.key-label {
  font-size: 22rpx;
  color: var(--text-2);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 20rpx;
}

/* 车辆档案 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
}
.info-row {
  width: 50%;
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.info-row .k {
  width: 130rpx;
  color: var(--text-3);
  font-size: 26rpx;
  flex-shrink: 0;
}
.info-row .v {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-1);
}

/* 车况 */
.report-card {
  display: flex;
  align-items: center;
}
.report-score {
  width: 160rpx;
  text-align: center;
  flex-shrink: 0;
  border-right: 1rpx solid var(--border);
  padding-right: 24rpx;
}
.score-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--green);
  line-height: 1;
}
.score-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.report-checks {
  flex: 1;
  padding-left: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.check-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--text-1);
}

/* 卖家 */
.seller-card {
  display: flex;
  align-items: center;
}
.seller-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.seller-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.seller-name {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.seller-type {
  font-size: 20rpx;
  color: var(--primary-dark);
  background: var(--primary-light);
  padding: 2rpx 12rpx;
  border-radius: var(--r-pill);
  margin-left: 12rpx;
  font-weight: 400;
}
.seller-loc {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.seller-phone {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-dark);
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}
.bar-ic {
  width: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-2);
}
.call-btn {
  flex: 1;
  margin-left: 24rpx;
  height: 84rpx;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: var(--shadow-float);
}
