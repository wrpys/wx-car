.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  padding: 20rpx 24rpx;
}

.location {
  display: flex;
  align-items: center;
}

.city-name {
  font-size: 28rpx;
  margin: 0 8rpx;
}

.arrow {
  font-size: 20rpx;
  color: #999;
}

.divider {
  color: #e5e5e5;
  margin: 0 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-btn {
  background-color: #FFD100;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.filter-bar {
  display: flex;
  background-color: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-item .arrow,
.filter-item .filter-icon {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #999;
}

.car-list {
  padding: 20rpx;
}

.car-card {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.car-image-wrap {
  position: relative;
  width: 200rpx;
  height: 150rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.car-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.urgent-tag {
  position: absolute;
  top: 0;
  left: 0;
  background-color: #ff6b35;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 0 8rpx 0;
}

.car-id-badge {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background-color: #FFD100;
  color: #333;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.car-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.car-title {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.car-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.car-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.tag {
  font-size: 20rpx;
  background-color: #f0f0f0;
  color: #666;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.tag-fuel {
  background-color: #e3f2fd;
  color: #1976d2;
}

.car-price {
  color: #e74c3c;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #FFD100;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: 300;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}