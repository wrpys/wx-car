.page {
  padding-bottom: 160rpx;
}

/* 搜索卡 */
.search-card {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 10rpx 12rpx 10rpx 20rpx;
  background: #fff;
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-card);
}
.location {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  white-space: nowrap;
}
.location .city {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin: 0 6rpx 0 8rpx;
}
.divider {
  width: 1rpx;
  height: 36rpx;
  background: var(--border);
  margin: 0 12rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-1);
}
.ph {
  color: var(--text-3);
}
.search-btn {
  flex-shrink: 0;
  white-space: nowrap;
  background: var(--primary);
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 36rpx;
  border-radius: var(--r-pill);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 0 24rpx 8rpx;
  border-radius: var(--r-md);
  padding: 8rpx 0;
  box-shadow: var(--shadow-card);
}
.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-2);
  position: relative;
  height: 64rpx;
}
.filter-item.active {
  color: var(--primary-dark);
  font-weight: 600;
}
.filter-item.active::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  width: 40rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--primary);
}

/* 车源卡片（样式已沉淀至 app.wxss 全局复用） */
.car-list {
  padding: 16rpx 24rpx 0;
}

/* 悬浮发布 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
  z-index: 50;
}
.fab:active {
  background: var(--primary-dark);
}
