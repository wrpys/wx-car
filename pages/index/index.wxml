<view class="page">
  <!-- 搜索卡 -->
  <view class="search-card">
    <view class="location" bindtap="onCityTap">
      <view class="ic ic-location-p"></view>
      <text class="city">{{city}}</text>
      <view class="ic ic-down" style="width:20rpx;height:20rpx;"></view>
    </view>
    <view class="divider"></view>
    <input
      class="search-input"
      placeholder="搜索品牌、车型或关键词"
      placeholder-class="ph"
      value="{{keyword}}"
      bindinput="onInput"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view
      class="filter-item {{activeFilter === index ? 'active' : ''}}"
      wx:for="{{filters}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onFilterTap"
    >
      <text>{{item}}</text>
      <view class="ic ic-down" style="width:18rpx;height:18rpx;"></view>
    </view>
  </view>

  <!-- 车源列表 -->
  <view class="car-list">
    <view
      class="car-card"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="onCarTap"
      data-id="{{item.id}}"
    >
      <view class="cover">
        <image class="cover-img" src="{{item.cover}}" mode="aspectFill" lazy-load="true"></image>
        <view class="badge-urgent" wx:if="{{item.urgent}}">急卖</view>
        <view class="badge-new" wx:if="{{item.isNew}}">新上架</view>
      </view>
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="meta">{{item.year}}年 · {{item.mileage}}万公里 · {{item.city}}</view>
        <view class="tags">
          <text class="tag tag-fuel">{{item.fuel}}</text>
          <text class="tag {{t.cls}}" wx:for="{{item.tagList}}" wx:for-item="t" wx:key="text">{{t.text}}</text>
        </view>
        <view class="price-row">
          <text class="price-num">{{item.price}}</text>
          <text class="price-unit">万</text>
          <text class="price-old" wx:if="{{item.originalPrice}}">新车指导 ¥{{item.originalPrice}}万</text>
        </view>
      </view>
    </view>
  </view>

  <view class="list-end">已经到底啦 ~</view>

  <!-- 悬浮发布 -->
  <view class="fab" bindtap="onPublish">
    <view class="ic ic-plus" style="width:44rpx;height:44rpx;"></view>
  </view>
</view>
