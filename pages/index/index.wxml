<view class="page">
  <view class="search-bar">
    <view class="location" bindtap="onCityChange">
      <text class="icon-search">🔍</text>
      <text class="city-name">{{city}}</text>
      <text class="arrow">▼</text>
    </view>
    <text class="divider">|</text>
    <input 
      class="search-input" 
      placeholder="搜索您要的车源" 
      value="{{searchKeyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <view class="filter-bar">
    <view class="filter-item" bindtap="onFilterTap" data-type="排序">
      <text>默认排序</text>
      <text class="arrow">⇅</text>
    </view>
    <view class="filter-item" bindtap="onFilterTap" data-type="品牌">
      <text>品牌</text>
      <text class="arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="onFilterTap" data-type="价格">
      <text>价格</text>
      <text class="arrow">▼</text>
    </view>
    <view class="filter-item" bindtap="onFilterTap" data-type="筛选">
      <text>筛选</text>
      <text class="filter-icon">▤</text>
    </view>
  </view>

  <view class="car-list">
    <view class="car-card" wx:for="{{cars}}" wx:key="id" bindtap="onCarTap" data-id="{{item.id}}">
      <view class="car-image-wrap">
        <image class="car-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="urgent-tag" wx:if="{{item.isUrgent}}">急卖</view>
        <view class="car-id-badge">{{item.id}}</view>
      </view>
      <view class="car-info">
        <view class="car-title">{{item.title}}</view>
        <view class="car-meta">{{item.year}}年 / {{item.mileage}} / {{item.city}}</view>
        <view class="car-tags">
          <text class="tag tag-fuel">{{item.fuel}}</text>
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="car-price">市场价{{item.price}}万</view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="onPublish">+</view>
</view>