.page {
  padding-bottom: 60rpx;
}

/* 顶部 */
.hero {
  margin: 24rpx;
  padding: 40rpx 36rpx 30rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(135deg, #FFC93C 0%, #FFB800 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 0, 0.3);
}
.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.hero-sub {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.7);
  margin-top: 10rpx;
}
.guarantees {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.g-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: 50%;
  font-size: 24rpx;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

/* 服务网格 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  margin: 32rpx 24rpx 20rpx;
}
.svc-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 12rpx;
}
.svc-card {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx 28rpx;
}
.svc-ic {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}
.svc-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-top: 16rpx;
}
.svc-desc {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

