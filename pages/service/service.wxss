/* 流程 */
.steps {
  display: flex;
  margin: 0 24rpx;
  background: #fff;
  border-radius: var(--r-md);
  padding: 32rpx 0;
  box-shadow: var(--shadow-card);
}
.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary-dark);
  font-weight: 700;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}
.step-text {
  font-size: 24rpx;
  color: var(--text-2);
}
