.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.result-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.car-card {
  width: 340rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.car-image {
  width: 100%;
  height: 200rpx;
}

.car-title {
  font-size: 26rpx;
  padding: 16rpx 16rpx 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.car-meta {
  font-size: 22rpx;
  color: #999;
  padding: 0 16rpx 8rpx;
}

.car-price {
  color: #e74c3c;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 16rpx 16rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}