.page {
  padding-bottom: 40rpx;
}

.result-bar {
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.result-bar .count {
  color: var(--price);
  font-weight: 700;
  font-size: 30rpx;
}

.car-list {
  padding: 0 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 40rpx;
}
.empty-btn {
  background: var(--primary);
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
  padding: 18rpx 56rpx;
  border-radius: var(--r-pill);
}
