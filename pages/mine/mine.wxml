<view class="page">
  <!-- 个人信息头部 -->
  <view class="profile">
    <image class="avatar" src="{{user.avatar}}" mode="aspectFill"></image>
    <view class="profile-info">
      <view class="name">{{user.name}}</view>
      <view class="level">{{user.level}}</view>
      <view class="phone">{{user.phone}}</view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats card">
    <view class="stat">
      <view class="stat-num">{{user.stats.publish}}</view>
      <view class="stat-label">在售车辆</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{user.stats.favorite}}</view>
      <view class="stat-label">我的收藏</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{user.stats.view}}</view>
      <view class="stat-label">浏览记录</view>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="menu card">
    <view
      class="menu-item"
      wx:for="{{menus}}"
      wx:key="key"
      data-name="{{item.name}}"
      bindtap="onMenuTap"
    >
      <view class="menu-name">{{item.name}}</view>
      <view class="menu-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
      <view class="ic ic-right" style="width:28rpx;height:28rpx;"></view>
    </view>
  </view>

  <view class="logout">退出登录</view>
</view>
