.page {
  padding-bottom: 60rpx;
}

.profile {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 50rpx;
  background: linear-gradient(135deg, #FFC93C 0%, #FFB800 100%);
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: #fff;
}
.profile-info {
  margin-left: 28rpx;
}
.name {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.level {
  display: inline-block;
  font-size: 20rpx;
  color: #1A1A1A;
  background: rgba(255, 255, 255, 0.55);
  padding: 2rpx 14rpx;
  border-radius: var(--r-pill);
  margin-top: 10rpx;
}
.phone {
  font-size: 24rpx;
  color: rgba(26, 26, 26, 0.7);
  margin-top: 8rpx;
}

.stats {
  margin: -32rpx 24rpx 0;
  position: relative;
  display: flex;
  padding: 32rpx 0;
}
.stat {
  flex: 1;
  text-align: center;
  position: relative;
}
.stat::after {
  content: '';
  position: absolute;
  right: 0;
  top: 10rpx;
  bottom: 10rpx;
  width: 1rpx;
  background: var(--border);
}
.stat:last-child::after { display: none; }
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}

.menu {
  margin-top: 24rpx;
  padding: 8rpx 28rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.menu-desc {
  font-size: 24rpx;
  color: var(--text-3);
  margin-right: 16rpx;
}

.logout {
  margin: 40rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  background: #fff;
  padding: 26rpx;
  border-radius: var(--r-md);
  box-shadow: var(--shadow-card);
}
