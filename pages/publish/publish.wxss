.page {
  padding: 24rpx 24rpx 160rpx;
}

.form {
  padding: 8rpx 28rpx;
}
.field {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.field.column {
  flex-direction: column;
  align-items: stretch;
}
.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text-1);
  flex-shrink: 0;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}
.input-inline {
  flex: 1;
  display: flex;
  align-items: center;
}
.suffix {
  font-size: 26rpx;
  color: var(--text-3);
  margin-left: 12rpx;
}
.ph {
  color: var(--text-3);
}
.picker {
  flex: 1;
}
.picker-text {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: var(--text-1);
}
.textarea {
  width: 100%;
  height: 160rpx;
  font-size: 26rpx;
  color: var(--text-1);
  margin-top: 16rpx;
  background: #F7F8FA;
  border-radius: var(--r-sm);
  padding: 20rpx;
}

/* 图片上传 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.img-item, .img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--r-sm);
  margin: 0 16rpx 16rpx 0;
  position: relative;
}
.img-thumb {
  width: 100%;
  height: 100%;
  border-radius: var(--r-sm);
}
.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 32rpx;
  line-height: 36rpx;
  text-align: center;
}
.img-add {
  background: #F2F3F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #C8CCD4;
}
.img-add-text {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.submit {
  margin-top: 40rpx;
  height: 92rpx;
  border-radius: var(--r-pill);
  background: var(--primary);
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-float);
}
