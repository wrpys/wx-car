.page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.search-header {
  display: flex;
  align-items: center;
  background-color: #FFD100;
  padding: 20rpx 24rpx;
}

.search-input {
  flex: 1;
  background-color: #fff;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.search-btn {
  background-color: #fff;
  color: #333;
  padding: 20rpx 32rpx;
  margin-left: 16rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.history-section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.history-title {
  font-size: 28rpx;
  font-weight: 500;
}

.clear-btn {
  font-size: 32rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #333;
}

.history-item:last-child {
  border-bottom: none;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}