.page {
  min-height: 100vh;
}

.search-head {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
}
.s-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F2F3F5;
  border-radius: var(--r-pill);
  padding: 14rpx 24rpx;
}
.s-input {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
  font-size: 28rpx;
}
.ph {
  color: var(--text-3);
}
.s-btn {
  margin-left: 20rpx;
  color: var(--primary-dark);
  font-size: 30rpx;
  font-weight: 600;
}

.block {
  background: #fff;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
}
.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.chips {
  white-space: nowrap;
}
.chip {
  display: inline-block;
  background: #F2F3F5;
  color: var(--text-2);
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: var(--r-pill);
  margin-right: 16rpx;
}

.empty {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 16rpx 0;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
}
.hot-item {
  width: 50%;
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.hot-rank {
  width: 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  font-style: italic;
}
.hot-word {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-1);
}
.hot-heat {
  font-size: 22rpx;
  color: var(--text-3);
}
